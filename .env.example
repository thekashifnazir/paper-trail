# Default data source: live (the engine on data/sample via /api, the default) or demo (in-browser fixtures).
# Viewers can switch in the top bar or with ?mode=demo|live.
NEXT_PUBLIC_DEFAULT_MODE=live

# Server-only. With both set, the /api routes read and write Supabase (lib/supabase-store.ts).
# Never prefix these with NEXT_PUBLIC_. CASH_DB=0 forces the in-memory engine even when they are set.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# CASH_DB=0
