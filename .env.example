# 1 (or unset) = in-browser mock data; 0 = the real /api routes.
NEXT_PUBLIC_USE_MOCK=1

# Server-only. With both set, the /api routes read and write Supabase (lib/supabase-store.ts).
# Never prefix these with NEXT_PUBLIC_. CASH_DB=0 forces the in-memory engine even when they are set.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# CASH_DB=0
